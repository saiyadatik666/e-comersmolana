# =============================================================================
# SHIFA A HAYAT — ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# IMPORTANT SECURITY GUIDANCE:
# 1. Do NOT put secret keys (e.g., SUPABASE_SERVICE_ROLE_KEY) into git-tracked .env.
# 2. In production, configure secrets via Cloudflare / hosting environment variables.
# 3. For local overrides, use .env.local (which is git-ignored).
# =============================================================================

# Public / Client-Side Keys (Safe for Browser)
SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
SUPABASE_URL="https://your-project-id.supabase.co"

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_your_key_here"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Server-Side Only Secrets (NEVER EXPOSE TO BROWSER OR GIT)
# Configure this in your secure hosting platform / .env.local:
# SUPABASE_SERVICE_ROLE_KEY="your-secret-service-role-key"
